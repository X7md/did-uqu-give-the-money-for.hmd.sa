---
import '@/index.css';
import { StampSection } from '@/components/sections/stamp-section';
import { Hero } from '@/components/sections/hero';
import { Counters } from '@/components/sections/counters';
import { BentoSection } from '@/components/sections/bento';
import { CasePathSection } from '@/components/sections/case-path';
import { FaqSection } from '@/components/sections/faq';
import { FAQ_LD } from '@/lib/case-data';
import { CASE_NAME, COVERAGE_RANGE, SITE_DESCRIPTION, SITE_LAUNCHED_ISO, SITE_TITLE } from '@/lib/updates';

const NAV = [
  ['ما هذا البدل؟', '#intro-title'],
  ['مسار القضية', '#path-title'],
  ['الأسئلة الشائعة', '#faq-title'],
];

const SITE_URL = Astro.site?.href ?? 'https://did-uqu-give-the-money-to.hmd.sa/';
const BUILD_TIME = new Date().toISOString(); // يتجدد مع إعادة البناء اليومية

// schema.org: موقع + صفحة أسئلة شائعة عن قضية جارية — dateModified يتحدث يوميًا،
// وtemporalCoverage فترة مفتوحة منذ بداية المدة المحكوم بها.
const LD = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}#website`,
      url: SITE_URL,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      inLanguage: 'ar',
    },
    {
      '@type': ['WebPage', 'FAQPage'],
      '@id': `${SITE_URL}#page`,
      url: SITE_URL,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      inLanguage: 'ar',
      isPartOf: { '@id': `${SITE_URL}#website` },
      datePublished: SITE_LAUNCHED_ISO,
      dateModified: BUILD_TIME,
      temporalCoverage: COVERAGE_RANGE,
      about: {
        '@type': 'Thing',
        name: CASE_NAME,
        identifier: [
          { '@type': 'PropertyValue', name: 'رقم الدعوى', value: '75594' },
          { '@type': 'PropertyValue', name: 'العام الهجري', value: '1447' },
        ],
      },
      mainEntity: FAQ_LD.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content="صفحة حالة فكاهية بسؤال واحد: هل صرفت جامعة أم القرى بدل الإعاقة عن فترة سابقة؟ الجواب حتى الآن: لا (ليس بعد). تستند لوقائع الدعوى 75594 لعام 1447هـ."
    />
    <title>هل صرفت الجامعة المستحقات؟ — لا (ليس بعد)</title>
    <link rel="canonical" href={SITE_URL} />
    <link rel="alternate" type="application/rss+xml" title="تحديثات القضية 75594" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="منصة «هل صُرفت المستحقات؟»" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={SITE_TITLE} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <script type="application/ld+json" set:html={JSON.stringify(LD)} />
  </head>
  <body>
    <div dir="rtl" class="flex min-h-dvh flex-col">
      <StampSection client:load />

      {/* شريط التنقل العلوي — على نمط dga-nav-header: 72px، خلفية بيضاء، فاصل سفلي */}
      <header
        class="sticky top-0 z-40 h-[72px] w-full bg-card after:absolute after:bottom-0 after:left-0 after:block after:h-px after:w-full after:bg-border"
      >
        <nav class="mx-auto flex h-full w-full max-w-3xl items-center justify-between px-5 lg:max-w-5xl">
          <div class="flex items-center">
            <span
              class="flex size-10 shrink-0 items-center justify-center rounded-md bg-primary text-lg font-black text-primary-foreground"
            >
              لا
            </span>
            <span class="mx-4 h-12 w-px bg-black/20" aria-hidden="true"></span>
            <div>
              <p class="m-0 text-sm font-bold">منصة «هل صُرفت المستحقات؟»</p>
              <p class="m-0 font-mono text-xs text-muted-foreground" dir="ltr">
                did-uqu-give-the-money-to.hmd.sa
              </p>
            </div>
          </div>
          <ul class="m-0 hidden h-full list-none items-center p-0 md:flex">
            {
              NAV.map(([label, href]) => (
                <li class="h-full">
                  <a
                    href={href}
                    class="inline-flex h-full items-center gap-1 rounded-sm px-6 text-sm text-foreground no-underline hover:bg-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
          <span
            class="hidden items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold text-muted-foreground sm:inline-flex"
          >
            الإصدار 1448.02 · يُحدَّث حتى الصرف
          </span>
        </nav>
      </header>

      <div class="mx-auto flex w-full max-w-3xl grow flex-col px-5 py-8 lg:max-w-5xl">
        {/* السؤال والجواب */}
        <main class="flex flex-col items-center gap-6 py-14 text-center">
          <Hero />
          <Counters client:load />
        </main>

        {/* التعريف — بينتو */}
        <section aria-labelledby="intro-title" class="pb-10">
          <h2 id="intro-title" class="m-0 mb-1 scroll-mt-6 text-xl font-bold">ما هذا «البدل» أصلًا؟</h2>
          <p class="m-0 mb-4 text-sm text-muted-foreground">
            تنظيم عمره أكثر من أربعين عامًا — لا طلبًا مستحدثًا.
          </p>
          <BentoSection client:load />
        </section>

        {/* مسار القضية */}
        <section aria-labelledby="path-title" class="pb-10">
          <h2 id="path-title" class="m-0 mb-1 scroll-mt-6 text-xl font-bold">مسار القضية باختصار</h2>
          <p class="m-0 mb-4 text-sm text-muted-foreground">
            النقطة المحورية: قرار الامتناع أُلغي بحكم ابتدائي — والخلاف الآن على تثبيت الإلغاء
            استئنافيًا لا على أصل الحق.
          </p>
          <CasePathSection client:load />
        </section>

        {/* الأسئلة الشائعة */}
        <section aria-labelledby="faq-title" class="pb-8">
          <h2 id="faq-title" class="m-0 mb-1 scroll-mt-6 text-xl font-bold">الأسئلة الشائعة</h2>
          <p class="m-0 mb-4 text-sm text-muted-foreground">
            كل إجابة أدناه مسنودة بوثيقة في ملف الدعوى 75594 لعام 1447هـ.
          </p>
          <FaqSection client:load />
        </section>

        <footer class="mt-auto border-t border-border pt-6 text-center text-xs leading-6 text-muted-foreground">
          <p class="m-0">
            موقع فكاهي توثيقي مستقل لا يمثل أي جهة — الوقائع من ملف الدعوى <bdi>75594</bdi> لعام
            <bdi>1447هـ</bdi>، ويُحدَّث الجواب فور الصرف.
          </p>
          <p class="m-0 pt-1">
            <a
              href="/rss.xml"
              class="inline-flex items-center gap-1 text-primary no-underline hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
              </svg>
              خلاصة RSS لتحديثات القضية
            </a>
          </p>
          <p class="m-0 pt-1 text-muted-foreground/80">
            © <bdi>١٤٤٨هـ</bdi> / <time datetime="2026">٢٠٢٦م</time>
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>
